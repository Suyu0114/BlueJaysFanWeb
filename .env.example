# Copy to .env.local (web) and etl/.env (Python ETL). Never commit the filled versions.

# ----- Supabase -----
# Project URL — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose in the browser (RLS protects writes)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — SERVER ONLY. Used by ETL to upsert and by /api/revalidate.
# Do not prefix with NEXT_PUBLIC_; do not commit.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ----- Next.js revalidation -----
# Shared secret the cron passes to /api/revalidate to trigger ISR rebuild.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ----- Optional: FanGraphs (v2) -----
# Leave unset for MVP. Only fill if v2 adds paid splits.
# FANGRAPHS_USER=
# FANGRAPHS_PASS=
