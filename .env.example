# Copy to web/.env.local (web) and .env at the repo root (Python ETL). Never commit the filled versions.

# ----- Database (required) -----
# Supabase Postgres connection string — read by the Next.js app (web/lib/db.ts)
# and the Python ETL (etl/db.py). This is the only var the MVP actually needs.
DATABASE_URL=postgresql://postgres:[your-password]@[your-host]:5432/postgres

# ----- Supabase (optional until P5) -----
# Project URL — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose in the browser (RLS protects writes)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — SERVER ONLY. Used by ETL to upsert and by /api/revalidate.
# Do not prefix with NEXT_PUBLIC_; do not commit.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ----- Next.js revalidation -----
# Shared secret the cron passes to /api/revalidate to trigger ISR rebuild.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ----- Optional: FanGraphs (v2) -----
# Leave unset for MVP. Only fill if v2 adds paid splits.
# FANGRAPHS_USER=
# FANGRAPHS_PASS=
